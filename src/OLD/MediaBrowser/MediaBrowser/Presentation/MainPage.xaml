<Page x:Class="MediaBrowser.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:MediaBrowser.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      x:DataType="local:MainModel"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--Top-->
    <StackPanel>
        <CommandBar Background="#596275" IsOpen="False" OverflowButtonVisibility="Collapsed">
            <AppBarButton x:Name="buttonWindow" 
                         Command="{x:Bind ViewModel.ToggleFullScreen}">
                <SymbolIcon x:Name="symbolButtonWindow" Symbol="BackToWindow"/>
            </AppBarButton>
            <AppBarButton x:Name="buttonClose" 
                         Icon="Clear" 
                         Command="{x:Bind ViewModel.CloseApp}"/>
        </CommandBar>
        <CommandBar Background="#596275" HorizontalAlignment="Left" OverflowButtonVisibility="Collapsed">
            <AppBarButton x:Name="buttonReturn" 
                         Icon="Back" 
                         Command="{x:Bind ViewModel.GoBack}"/>
            <AppBarButton x:Name="buttonHome" 
                         Icon="Home" 
                         Command="{x:Bind ViewModel.GoHome}"/>
        </CommandBar>

        <!--Center-->
        <Pivot Margin="0,48,0,48" SelectedIndex="{x:Bind ViewModel.SelectedPivotIndex}">
            <PivotItem Header="Tasks">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="buttonExit" 
                           Margin="54,43,0,0" 
                           VerticalAlignment="Top" 
                           Height="136" 
                           Width="225" 
                           Command="{x:Bind ViewModel.Exit}">
                        <StackPanel>
                            <SymbolIcon Symbol="DockBottom"/>
                            <TextBlock Text="Exit"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="buttonAbout" 
                           Margin="54,43,0,0" 
                           VerticalAlignment="Top" 
                           Height="136" 
                           Width="225" 
                           Command="{x:Bind ViewModel.ShowAbout}">
                        <StackPanel>
                            <SymbolIcon Symbol="Help"/>
                            <TextBlock Text="About"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </PivotItem>
            <PivotItem Header="Pictures">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="myPicturesButton" 
                           Margin="54,43,0,0" 
                           VerticalAlignment="Top" 
                           Height="136" 
                           Width="225" 
                           Command="{x:Bind ViewModel.OpenMyPictures}">
                        <StackPanel>
                            <SymbolIcon Symbol="Pictures"/>
                            <TextBlock Text="My Pictures"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="cameraButton" 
                           Margin="54,43,0,0" 
                           VerticalAlignment="Top" 
                           Height="136" 
                           Width="225" 
                           Command="{x:Bind ViewModel.OpenCamera}">
                        <StackPanel>
                            <SymbolIcon Symbol="Camera"/>
                            <TextBlock Text="Camera"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </PivotItem>
            <PivotItem Header="Music">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="myMusicButton" 
                           Margin="54,43,0,0" 
                           VerticalAlignment="Top" 
                           Height="136" 
                           Width="225" 
                           Command="{x:Bind ViewModel.OpenMyMusic}">
                        <StackPanel>
                            <SymbolIcon Symbol="MusicInfo"/>
                            <TextBlock Text="My Music"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </PivotItem>
            <PivotItem Header="Videos">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="myVideosButton" 
                           Margin="54,43,0,0" 
                           VerticalAlignment="Top" 
                           Height="136" 
                           Width="225" 
                           Command="{x:Bind ViewModel.OpenMyVideos}">
                        <StackPanel>
                            <SymbolIcon Symbol="Video"/>
                            <TextBlock Text="My Videos"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </PivotItem>
            <PivotItem Header="Extras">
                <StackPanel Orientation="Horizontal">
                    <Button Margin="54,43,0,0" 
                           VerticalAlignment="Top" 
                           Height="136" 
                           Width="225" 
                           Command="{x:Bind ViewModel.OpenBingMap}">
                        <Image Source="Images/BingMap.jpg"/>
                    </Button>
                </StackPanel>
            </PivotItem>
        </Pivot>

        <!--Bottom-->
        <CommandBar Background="#1e2333" IsOpen="False" VerticalAlignment="Bottom" OverflowButtonVisibility="Collapsed"/>
    </StackPanel>
</Page>
