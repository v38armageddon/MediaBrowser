<Page
    x:Class="MediaBrowser.Apps.PicturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MediaBrowser.Apps"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    RequestedTheme="{StaticResource PrimaryTheme}">

    <Grid Background="{ThemeResource BackgroundBrush}">
        <!--Top-->
        <CommandBar Background="{ThemeResource TopBarBrush}" IsOpen="False" OverflowButtonVisibility="Collapsed">
            <AppBarButton x:Name="buttonWindow" x:FieldModifier="public" Click="buttonWindow_Click">
                <SymbolIcon x:Name="symbolButtonWindow" Symbol="BackToWindow"/>
            </AppBarButton>
        </CommandBar>
        <CommandBar Background="{ThemeResource TopBarBrush}" HorizontalAlignment="Left" OverflowButtonVisibility="Collapsed">
            <AppBarButton x:Name="buttonReturn" Icon="Back" Click="buttonReturn_Click"/>
            <AppBarButton x:Name="buttonHome" Icon="Home" Click="buttonHome_Click"/>
        </CommandBar>

        <!--Center-->
        <Image x:Name="Image" Margin="0,48,0,48"/>

        <!--Bottom-->
        <CommandBar Background="{ThemeResource BottomBarBrush}" IsOpen="False" VerticalAlignment="Bottom">
            <AppBarButton x:Name="previousButton" x:Uid="previousButton" Icon="Previous" Click="previousButton_Click"/>
            <AppBarButton x:Name="nextButton" x:Uid="nextButton" Icon="Next" Click="nextButton_Click"/>
            <AppBarSeparator/>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="openFileButton" x:Uid="openPFileButton" Icon="OpenFile" Click="openFileButton_Click"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <InfoBar
            x:Name="infoBar"
            IsOpen="True"
            Visibility="Collapsed"
            Severity="Error"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Title="Error"
            Message="No pictures loaded, make sure you open the file before viewing it." Margin="0,0,0,53" CloseButtonClick="infoBar_CloseButtonClick" />
    </Grid>
</Page>
